<odoo>
    <data>

        <record id="view_hr_hospital_patient_list" model="ir.ui.view">
            <field name="name">hr.hospital.patient.list</field>
            <field name="model">hr.hospital.patient</field>
            <field name="arch" type="xml">
                <list string="Patients">
                    <field name="name"/>
                    <field name="doctor_id"/>
                </list>
            </field>
        </record>

        <record id="view_hr_hospital_patient_form" model="ir.ui.view">
            <field name="name">hr.hospital.patient.form</field>
            <field name="model">hr.hospital.patient</field>
            <field name="arch" type="xml">
                <form string="Patient">
                    <header>
                        <button name="action_open_patient_visits"
                                type="object"
                                string="Visit History"
                                class="btn-primary"/>
                        <button name="action_create_quick_visit"
                                type="object"
                                string="New Visit"
                                class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="history_ids"/>
                            <field name="blood_group"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                            <field name="doctor_id"/>
                            <field name="insurance_number"/>
                            <field name="doctor_change_date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_hospital_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">hr.hospital.patient</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
        </record>

    </data>
</odoo>